<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 도형의 내부 색상을 흰색으로 설정 -->
    <solid android:color="#FFFFFF"/>
    <!-- 도형의 모서리를 둥글게 설정 (반지름 10dp) -->
    <corners android:radius="10dp" />
    <!-- 도형의 외곽선을 설정 (너비 2dp, 색상 #808080) -->
    <stroke android:width="0dp" android:color="#808080" />
    <!-- 그림자 효과 설정 -->
    <item>
        <shape android:shape="rectangle">
            <!-- 그림자의 색상을 투명도 25%의 검정색으로 설정 -->
            <solid android:color="#40000000"/>
            <!-- 그림자의 모서리를 둥글게 설정 (반지름 10dp) -->
            <corners android:radius="10dp" />
        </shape>
    </item>
</shape>
