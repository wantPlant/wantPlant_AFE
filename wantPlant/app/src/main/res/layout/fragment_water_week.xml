<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/water_week_change_calendar_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingLeft="5dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="@id/water_week_calendar_ll">
        <TextView
            android:id="@+id/water_week_change_calendar_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="@string/water_change_calendar"
            android:fontFamily="@font/seoulhangang_ceb"/>

        <ImageView
            android:id="@+id/water_week_change_calendar_iv"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="3dp"
            android:src="@drawable/ic_water_solar_refresh_linear"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/water_week_garden_title_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="1dp"
        android:layout_marginTop="5dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/water_week_change_calendar_ll"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:id="@+id/item_water_week_garden_title_non_ll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingRight="18dp"
        android:paddingLeft="18dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/rect_whitefill_mainstroke_15radius2"
        android:backgroundTint="@color/wp_main_btn"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/water_week_change_calendar_ll"
        app:layout_constraintStart_toStartOf="@id/water_week_calendar_ll"
        app:layout_constraintEnd_toEndOf="@id/water_week_calendar_ll">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_flower_outline"
            app:tint="@color/wp_brown1"/>

        <TextView
            android:id="@+id/item_water_week_garden_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wp_brown1"
            android:text="@string/water_week_non_garden"
            android:textSize="10dp"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/seoulhangang_ceb"/>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/water_week_calendar_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/item_water_week_garden_title_non_ll"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/rect_nonfill_mainstroke_15radius">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="5dp">

            <ImageView
                android:id="@+id/water_week_back_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_water_back"
                android:layout_marginStart="20dp"
                android:padding="5dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/water_week_year_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/seoulhangang_ceb"
                android:text="2022년 6월"
                android:textColor="@color/wp_green3"
                android:textSize="18dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <ImageView
                android:id="@+id/water_week_forward_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_water_forward"
                android:layout_marginEnd="20dp"
                android:padding="5dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/water_week_day_list_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/water_week_pot_title_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/water_week_calendar_ll"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/water_week_non_pot_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/water_week_non_pot"
        android:textSize="13dp"
        android:textColor="@color/wp_gray2"
        android:textStyle="bold"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/border_nonfill_greenstroke_15radius"
        app:layout_constraintTop_toBottomOf="@id/water_week_calendar_ll"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="invisible"/>

    <LinearLayout
        android:id="@+id/water_week_add_goal_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginStart="15dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/water_week_non_pot_title_tv"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/water_week_add_pot_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_garden_plus_btn"/>

        <TextView
            android:id="@+id/water_week_add_pot_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/water_week_add_goal"
            android:textStyle="bold"
            android:textColor="@color/wp_brown2"
            android:layout_marginStart="5dp"
            android:textSize="15dp"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/water_week_goal_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/water_week_add_goal_ll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_water_week_goal"/>



</androidx.constraintlayout.widget.ConstraintLayout>