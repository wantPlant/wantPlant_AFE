<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/water_week_change_calendar_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:text="@string/water_change_calendar" />

        <ImageView
            android:id="@+id/water_week_change_calendar_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:src="@drawable/ic_water_solar_refresh_linear"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/water_week_calendar_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/water_week_change_calendar_ll"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:id="@+id/water_week_add_goal_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginStart="15dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/water_week_calendar_rv"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/water_week_add_pot_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_garden_plus_btn"/>

        <TextView
            android:id="@+id/water_week_add_pot_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/water_week_add_goal"
            android:textStyle="bold"
            android:textColor="@color/wp_brown2"
            android:layout_marginStart="5dp"
            android:textSize="15dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/water_week_pot_title_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/water_week_add_goal_ll"
        app:layout_constraintStart_toStartOf="parent"
        android:orientation="horizontal"
        tools:listitem="@layout/item_water_week_pot_title"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/water_week_goal_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/water_week_pot_title_rv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_water_week_goal"/>



</androidx.constraintlayout.widget.ConstraintLayout>