<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/water_week_change_calendar_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:text="@string/water_change_calendar" />

        <ImageView
            android:id="@+id/water_week_change_calendar_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:src="@drawable/ic_water_solar_refresh_linear"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/water_week_calendar_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/rect_nonfill_mainstroke_15radius"
        app:layout_constraintTop_toBottomOf="@id/water_week_change_calendar_ll"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/water_week_calendar_back_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_water_back"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toTopOf="@id/water_week_date_tv"
            app:layout_constraintBottom_toBottomOf="@id/water_week_date_tv"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/water_week_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/seoulhangang_ceb"
            android:textColor="@color/wp_green3"
            android:textSize="20dp"
            android:text="2024년 1월"
            android:layout_marginTop="10dp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/water_week_calendar_forward_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_water_forward"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toTopOf="@id/water_week_date_tv"
            app:layout_constraintBottom_toBottomOf="@id/water_week_date_tv"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!--
        <com.michalsvec.singlerowcalendar.calendar.SingleRowCalendar
            android:id="@+id/water_week_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:deselection="false"
            app:longPress="false"
            app:multiSelection="false"
            app:layout_constraintTop_toBottomOf="@id/water_week_date_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>-->


    </androidx.constraintlayout.widget.ConstraintLayout>
    <HorizontalScrollView
        android:id="@+id/water_week_title_hsv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/water_week_calendar_cl"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="화분 이름"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/border_nonfill_greenstroke_15radius"/>

    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/water_week_goal_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/water_week_title_hsv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_water_week_goal"/>



</androidx.constraintlayout.widget.ConstraintLayout>