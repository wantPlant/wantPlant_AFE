<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="280dp"
    android:orientation="vertical"
    android:paddingBottom="24dp"
    android:background="@drawable/rect_whitefill_bluestroke_15radius"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditText
        android:id="@+id/dialog_water_month_todo_et"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/rect_bluefill_nonstroke_15radius"
        android:gravity="center"
        android:hint="할 일"
        android:textSize="16sp"
        android:layout_marginTop="25dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/dialog_water_month_time_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_water_month_todo_et"
        app:layout_constraintStart_toStartOf="@id/dialog_water_month_todo_et">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_dialog_watch"/>
        <TextView
            android:id="@+id/dialog_water_month_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_garden_month_time"
            android:textColor="@color/wp_gray2"
            android:layout_marginStart="5dp"
            android:textSize="13dp"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialog_water_month_date_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15sp"
        app:layout_constraintTop_toBottomOf="@id/dialog_water_month_time_ll"
        app:layout_constraintStart_toStartOf="@id/dialog_water_month_todo_et">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_dialog_calendar"/>
        <TextView
            android:id="@+id/dialog_water_month_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_garden_month_date"
            android:textColor="@color/wp_gray2"
            android:layout_marginStart="5dp"
            android:textSize="13dp"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <TextView
        android:id="@+id/dialog_water_month_choose_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_garden_month_choose"
        android:textSize="10sp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_water_month_date_ll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/dialog_water_month_color1_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_water_month_choose_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/dialog_water_month_color1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/wp_green5"
            android:layout_marginEnd="10dp"
            android:background="@drawable/oval_nonfill_nonstroke"/>

        <TextView
            android:id="@+id/dialog_water_month_color2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/wp_green7"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/oval_nonfill_nonstroke"/>

        <TextView
            android:id="@+id/dialog_water_month_color3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/wp_green8"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/oval_nonfill_nonstroke"/>

        <TextView
            android:id="@+id/dialog_water_month_color4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/wp_green3"
            android:layout_marginStart="10dp"
            android:background="@drawable/oval_nonfill_nonstroke"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialog_water_month_color2_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_water_month_color1_ll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/dialog_water_month_color5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/wp_main_btn"
            android:layout_marginEnd="10dp"
            android:background="@drawable/oval_nonfill_nonstroke"/>

        <TextView
            android:id="@+id/dialog_water_month_color6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/wp_brown6"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/oval_nonfill_nonstroke"/>

        <TextView
            android:id="@+id/dialog_water_month_color7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/wp_brown7"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/oval_nonfill_nonstroke"/>

        <TextView
            android:id="@+id/dialog_water_month_color8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/wp_brown8"
            android:layout_marginStart="10dp"
            android:background="@drawable/oval_nonfill_nonstroke"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialog_water_month_color1_select_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_water_month_choose_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/dialog_water_month_color1_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/border_nonfill_blackstroke"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/dialog_water_month_color2_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/border_nonfill_blackstroke"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/dialog_water_month_color3_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/border_nonfill_blackstroke"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/dialog_water_month_color4_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/border_nonfill_blackstroke"
            android:visibility="invisible"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialog_water_month_color2_select_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_water_month_color1_ll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/dialog_water_month_color5_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/border_nonfill_blackstroke"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/dialog_water_month_color6_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/border_nonfill_blackstroke"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/dialog_water_month_color7_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/border_nonfill_blackstroke"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/dialog_water_month_color8_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/border_nonfill_blackstroke"
            android:visibility="invisible"/>

    </LinearLayout>


    <TextView
        android:id="@+id/dialog_water_month_cancel_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_garden_month_cancel"
        android:background="@drawable/rect_mainfill_nonstroke_15radius"
        android:textSize="14sp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_water_month_color2_ll"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/dialog_water_month_complete_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_garden_month_complete"
        android:background="@drawable/rect_mainfill_nonstroke_15radius"
        android:textSize="14sp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_water_month_color2_ll"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>