    <TextView
        android:id="@+id/dialog_plant_goal_et"
        android:layout_width="138dp"
        android:layout_height="69dp"
        android:background="@drawable/rect_bluefill_nonstroke_15radius"
        android:gravity="center"
        android:text="큰 목표"
        android:paddingTop="6dp"
        android:paddingLeft="10dp"
        android:paddingRight="6dp"
        android:textSize="14sp"
        android:letterSpacing="0.02"
        android:paddingBottom="43dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/dialog_plant_background_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/rect_dialog_todo_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="31dp"/>

    <EditText
        android:id="@+id/dialog_plant_work_et"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/rect_dialog_todo_work"
        android:gravity="center"
        android:hint="할 일"
        android:textSize="16dp"
        android:layout_marginTop="55dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingRight="10dp"
        android:paddingLeft="10dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_plant_background_iv"
        app:layout_constraintStart_toStartOf="@+id/dialog_plant_background_iv"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/dialog_plant_month_time_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="31dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_plant_work_et"
        app:layout_constraintStart_toStartOf="@id/dialog_plant_work_et">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_dialog_watch"
            android:layout_marginStart="1dp"/>

        <TextView
            android:id="@+id/dialog_plant_month_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_garden_month_time"
            android:textColor="@color/wp_gray2"
            android:layout_marginStart="5dp"
            android:textSize="13dp"
            android:layout_gravity="center_vertical"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialog_plant_month_date_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_plant_month_time_ll"
        app:layout_constraintStart_toStartOf="@id/dialog_plant_month_time_ll">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_dialog_calendar"/>

        <TextView
            android:id="@+id/dialog_plant_month_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_garden_month_date"
            android:textColor="@color/wp_gray2"
            android:layout_marginStart="5dp"
            android:textSize="13dp"
            android:layout_gravity="center_vertical"/>

    </LinearLayout>

    <android.widget.Button
        android:id="@+id/dialog_plant_cancel_btn"
        android:layout_width="60dp"
        android:layout_height="23dp"
        android:text="@string/dialog_garden_month_cancel"
        android:background="@drawable/rect_dialog_todo_btn"
        android:textSize="12dp"
        android:gravity="center"
        android:layout_marginStart="13dp"
        android:layout_marginTop="26dp"
        app:layout_constraintTop_toBottomOf="@+id/dialog_plant_month_date_ll"
        app:layout_constraintStart_toStartOf="@+id/dialog_plant_background_iv"/>

    <android.widget.Button
        android:id="@+id/dialog_plant_complete_btn"
        android:layout_width="60dp"
        android:layout_height="23dp"
        android:text="@string/dialog_garden_month_complete"
        android:background="@drawable/rect_dialog_todo_btn"
        android:textSize="12dp"
        android:gravity="center"
        android:layout_marginEnd="13dp"
        app:layout_constraintTop_toTopOf="@+id/dialog_plant_cancel_btn"
        app:layout_constraintEnd_toEndOf="@+id/dialog_plant_background_iv"/>

</androidx.constraintlayout.widget.ConstraintLayout>