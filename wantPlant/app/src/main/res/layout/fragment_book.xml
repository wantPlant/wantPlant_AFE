<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <ImageView
        android:id="@+id/book_logo_wantplant_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="65dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:src="@drawable/ic_logo_wantplant"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/book_garden_name_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/book_logo_wantplant_iv"
        app:layout_constraintStart_toStartOf="parent"
        android:overScrollMode="never"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_book_garden_name" />

    <LinearLayout
        android:id="@+id/book_create_garden_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"
        android:paddingLeft="13dp"
        android:paddingRight="13dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/border_nonfill_greenstroke_15radius"
        app:layout_constraintTop_toBottomOf="@id/book_logo_wantplant_iv"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="invisible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="정원을 만들어주세요."
            android:textColorHint="@color/wp_gray2"
            android:textSize="13dp"
            android:privateImeOptions="korean"
            android:background="@null"
            android:letterSpacing="0.02"
            android:textColor="#757373"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/book_create_garden_ll"
        android:layout_marginTop="89dp"
        android:id="@+id/book_plant_not_cl"
        android:visibility="invisible"
        >

        <androidx.cardview.widget.CardView
            android:id="@+id/book_speech_bubble_01_cv"
            android:layout_width="308dp"
            android:layout_height="126dp"
            app:cardCornerRadius="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:elevation="7dp"
            app:cardBackgroundColor="@color/wp_main_btn"
            >

            <TextView
                android:id="@+id/book_speech_bubble_tv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:shadowColor="#40000000"
                android:shadowRadius="3"
                android:text="@string/whole_no_flowerpot"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/book_speech_bubble_02_cl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="117dp"
            android:src="@drawable/ic_polygon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/book_speech_bubble_01_cv" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/book_speech_bubble_01_cv">

            <ImageView
                android:id="@+id/book_cat_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingRight="6dp"
                android:src="@drawable/img_cat" />

            <ImageView
                android:id="@+id/book_dog_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="6dp"
                android:src="@drawable/img_dog" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="parent"
        android:layout_marginTop="225dp"
        android:id="@+id/book_plant_all_cl">

        <ImageView
            android:id="@+id/book_rectangle_image_01_iv"
            android:layout_width="300dp"
            android:layout_height="33dp"
            android:src="@drawable/img_rectangle_4"
            android:layout_marginTop="21dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/book_garden_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whole_garden_name"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/book_rectangle_image_01_iv"
            app:layout_constraintEnd_toEndOf="@+id/book_rectangle_image_01_iv"
            app:layout_constraintBottom_toBottomOf="@+id/book_rectangle_image_01_iv"
            app:layout_constraintTop_toTopOf="@+id/book_rectangle_image_01_iv"/>

        <ImageView
            android:id="@+id/book_vertical_line_01_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vertical_line"
            android:layout_marginStart="94dp"
            app:layout_constraintTop_toBottomOf="@id/book_rectangle_image_01_iv"
            app:layout_constraintStart_toStartOf="@id/book_rectangle_image_01_iv"/>

        <ImageView
            android:id="@+id/book_vertical_line_02_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vertical_line"
            android:layout_marginEnd="94dp"
            app:layout_constraintTop_toBottomOf="@id/book_rectangle_image_01_iv"
            app:layout_constraintEnd_toEndOf="@id/book_rectangle_image_01_iv"/>

        <ImageView
            android:id="@+id/book_rectangle_02_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_rectangle_5"
            app:layout_constraintTop_toBottomOf="@id/book_vertical_line_02_iv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/book_category_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whole_category"
            android:textStyle="bold"
            android:layout_marginTop="33dp"
            android:layout_marginStart="40dp"
            app:layout_constraintStart_toStartOf="@+id/book_rectangle_02_iv"
            app:layout_constraintTop_toTopOf="@+id/book_rectangle_02_iv"
            android:textSize="8sp"
            android:letterSpacing="0.03"
            android:textColor="#616161"
            android:lineSpacingExtra="11sp" />

        <TextView
            android:id="@+id/book_category_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whole_category_label"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/book_category_tv"
            app:layout_constraintTop_toTopOf="@+id/book_category_tv"
            app:layout_constraintBottom_toBottomOf="@+id/book_category_tv"
            android:textSize="10sp"
            android:letterSpacing="0.03"
            android:lineSpacingExtra="8sp" />

        <TextView
            android:id="@+id/book_explain_garden_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whole_explain_garden"
            android:textStyle="bold"
            android:layout_marginTop="13dp"
            android:layout_marginStart="40dp"
            app:layout_constraintStart_toStartOf="@+id/book_rectangle_02_iv"
            app:layout_constraintTop_toBottomOf="@+id/book_category_tv"
            android:textSize="8sp"
            android:letterSpacing="0.03"
            android:textColor="#616161"
            android:lineSpacingExtra="11sp" />

        <TextView
            android:id="@+id/book_explain_garden_label_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whole_explain_garden_label"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/book_explain_garden_tv"
            app:layout_constraintTop_toTopOf="@+id/book_explain_garden_tv"
            app:layout_constraintBottom_toBottomOf="@+id/book_explain_garden_tv"
            android:textSize="10sp"
            android:letterSpacing="0.03"
            android:lineSpacingExtra="8sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/book_flowerpot_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="31dp"
            app:layout_constraintTop_toBottomOf="@+id/book_rectangle_02_iv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:overScrollMode="never"
            android:orientation="vertical"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:listitem="@layout/item_book_flowerpot" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
