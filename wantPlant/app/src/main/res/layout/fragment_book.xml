<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/whole_logo_wantplant_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="65dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:src="@drawable/ic_logo_wantplant"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <HorizontalScrollView
        android:id="@+id/whole_water_week_title_hsv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/whole_logo_wantplant_iv"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="invisible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5sp"
            android:gravity="center"
            android:text="@string/whole_garden_name"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/ic_create_garden"/>

    </HorizontalScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:background="@drawable/ic_create_garden"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/whole_logo_wantplant_iv"
        android:textSize="13sp"
        android:letterSpacing="0.02"
        android:textColor="#757373"
        android:id="@+id/whole_create_garden_acb"
        android:layout_width="144dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="@string/whole_create_garden" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/whole_create_garden_acb"
        android:layout_marginTop="89dp"
        >

        <androidx.cardview.widget.CardView
            android:id="@+id/whole_speech_bubble_01_cv"
            android:layout_width="308dp"
            android:layout_height="126dp"
            app:cardCornerRadius="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:elevation="7dp"
            app:cardBackgroundColor="@color/wp_main_btn"
            >

            <TextView
                android:id="@+id/whole_speech_bubble_tv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="-7sp"
                android:shadowColor="#40000000"
                android:shadowRadius="3"
                android:text="@string/whole_no_flowerpot"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/whole_speech_bubble_02_cl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="117dp"
            android:src="@drawable/ic_polygon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/whole_speech_bubble_01_cv" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/whole_speech_bubble_01_cv">

            <ImageView
                android:id="@+id/whole_cat_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingRight="6dp"
                android:src="@drawable/img_cat" />

            <ImageView
                android:id="@+id/whole_dog_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="6dp"
                android:src="@drawable/img_dog" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="parent"
        android:layout_marginTop="225dp"
        android:visibility="invisible"
        >
        <ImageView
            android:id="@+id/whole_rectangle_image_01_iv"
            android:layout_width="300dp"
            android:layout_height="33dp"
            android:src="@drawable/img_rectangle_4"
            android:layout_marginTop="21dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whole_garden_name"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/whole_rectangle_image_01_iv"
            app:layout_constraintEnd_toEndOf="@+id/whole_rectangle_image_01_iv"
            app:layout_constraintBottom_toBottomOf="@+id/whole_rectangle_image_01_iv"
            app:layout_constraintTop_toTopOf="@+id/whole_rectangle_image_01_iv"/>

        <ImageView
            android:id="@+id/whole_vertical_line_01_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vertical_line"
            android:layout_marginStart="94dp"
            app:layout_constraintTop_toBottomOf="@id/whole_rectangle_image_01_iv"
            app:layout_constraintStart_toStartOf="@id/whole_rectangle_image_01_iv"/>

        <ImageView
            android:id="@+id/whole_vertical_line_02_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vertical_line"
            android:layout_marginEnd="94dp"
            app:layout_constraintTop_toBottomOf="@id/whole_rectangle_image_01_iv"
            app:layout_constraintEnd_toEndOf="@id/whole_rectangle_image_01_iv"/>

        <ImageView
            android:id="@+id/whole_rectangle_02_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_rectangle_5"
            app:layout_constraintTop_toBottomOf="@id/whole_vertical_line_02_iv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/whole_category_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whole_category"
            android:textStyle="bold"
            android:layout_marginTop="33dp"
            android:layout_marginStart="40dp"
            app:layout_constraintStart_toStartOf="@+id/whole_rectangle_02_iv"
            app:layout_constraintTop_toTopOf="@+id/whole_rectangle_02_iv"
            android:textSize="8sp"
            android:letterSpacing="0.03"
            android:textColor="#616161"
            android:lineSpacingExtra="11sp" />

        <TextView
            android:id="@+id/category_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whole_category_label"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/whole_category_tv"
            app:layout_constraintTop_toTopOf="@+id/whole_category_tv"
            app:layout_constraintBottom_toBottomOf="@+id/whole_category_tv"
            android:textSize="10sp"
            android:letterSpacing="0.03"
            android:lineSpacingExtra="8sp" />

        <TextView
            android:id="@+id/whole_explain_garden_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whole_explain_garden"
            android:textStyle="bold"
            android:layout_marginTop="13dp"
            android:layout_marginStart="40dp"
            app:layout_constraintStart_toStartOf="@+id/whole_rectangle_02_iv"
            app:layout_constraintTop_toBottomOf="@+id/whole_category_tv"
            android:textSize="8sp"
            android:letterSpacing="0.03"
            android:textColor="#616161"
            android:lineSpacingExtra="11sp" />

        <TextView
            android:id="@+id/whole_explain_garden_label_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whole_explain_garden_label"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/whole_explain_garden_tv"
            app:layout_constraintTop_toTopOf="@+id/whole_explain_garden_tv"
            app:layout_constraintBottom_toBottomOf="@+id/whole_explain_garden_tv"
            android:textSize="10sp"
            android:letterSpacing="0.03"
            android:lineSpacingExtra="8sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/whole_flowerpot_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toBottomOf="@+id/whole_rectangle_02_iv"
            android:layout_marginTop="31dp"
            android:orientation="vertical"
            tools:listitem="@layout/item_flowerpot" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>