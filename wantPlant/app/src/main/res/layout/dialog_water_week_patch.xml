<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="360dp"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/dialog_water_week_goal_tv"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/rect_bluefill_nonstroke_15radius2"
        android:gravity="center"
        android:text="목표"
        android:textSize="14dp"
        android:textColor="@color/black"
        android:layout_marginTop="25dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rect_whitefill_bluestroke_15radius"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_water_week_goal_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/dialog_water_week_todo_et"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/rect_bluefill_nonstroke_15radius"
            android:gravity="center"
            android:hint="할 일"
            android:textSize="16dp"
            android:textColor="@color/black"
            android:layout_marginTop="25dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/dialog_water_week_time_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/dialog_water_week_todo_et"
            app:layout_constraintStart_toStartOf="@id/dialog_water_week_todo_et">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_dialog_watch"/>
            <TextView
                android:id="@+id/dialog_water_week_time_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_garden_month_time"
                android:textColor="@color/wp_gray2"
                android:layout_marginStart="5dp"
                android:textSize="13dp"
                android:layout_gravity="center_vertical"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dialog_water_week_date_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/dialog_water_week_time_ll"
            app:layout_constraintStart_toStartOf="@id/dialog_water_week_todo_et">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_dialog_calendar"/>
            <TextView
                android:id="@+id/dialog_water_week_date_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_garden_month_date"
                android:textColor="@color/wp_gray2"
                android:layout_marginStart="5dp"
                android:textSize="13dp"
                android:layout_gravity="center_vertical"/>
        </LinearLayout>


        <TextView
            android:id="@+id/dialog_water_week_delete_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_garden_month_delete"
            android:background="@drawable/rect_mainfill_nonstroke_15radius"
            android:textSize="12dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/dialog_water_week_date_ll"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/dialog_water_week_complete_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_garden_month_complete"
            android:background="@drawable/rect_mainfill_nonstroke_15radius"
            android:textSize="12dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/dialog_water_week_date_ll"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>