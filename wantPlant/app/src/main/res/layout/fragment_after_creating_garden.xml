<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF">

        <ImageView
            android:id="@+id/logo_wantplant_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="65dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_logo_wantplant"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/speech_bubble_01_cv"
            android:layout_width="308dp"
            android:layout_height="126dp"
            app:cardCornerRadius="30dp"
            android:layout_marginTop="155dp"
            app:layout_constraintTop_toBottomOf="@+id/logo_wantplant_iv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:cardElevation="7dp"
            app:cardBackgroundColor="@color/wp_main_btn">

            <TextView
                android:id="@+id/speech_bubble_tv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="아직 다 키운 화분이 없어요\nㅠ_ㅠ"
                android:lineSpacingExtra="-7sp"
                android:textSize="23sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:textColor="#FFFFFF"
                android:shadowColor="#40000000"
                android:shadowRadius="3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/speech_bubble_02_cl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="272dp"
            android:src="@drawable/ic_polygon_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logo_wantplant_iv" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/speech_bubble_01_cv">

            <ImageView
                android:id="@+id/cat_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingRight="6dp"
                android:src="@drawable/cat_image" />

            <ImageView
                android:id="@+id/dog_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="6dp"
                android:src="@drawable/dog_image" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>