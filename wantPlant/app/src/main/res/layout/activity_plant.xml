<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:id="@+id/plant_layout_cl">

    <ImageView
        android:id="@+id/plant_back_iv"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="11dp"
        android:layout_marginTop="38dp"
        android:background="@color/white"
        android:scaleType="fitXY"
        android:src="@drawable/ion_chevron_back_outline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/plant_label_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/plant_back_iv"
        app:layout_constraintBottom_toBottomOf="@+id/plant_back_iv">

        <ImageView
            android:id="@+id/plant_sparkle_iv"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_sparkles_outline"/>

        <TextView
            android:id="@+id/plant_water_check_TODO_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="투두를 체크할 때마다 물을 줄 수 있어요."
            android:textSize="10sp"
            android:letterSpacing="0.03"
            android:textColor="#ACB774"
            />

    </LinearLayout>

    <EditText
        android:background="@drawable/ic_create_garden"
        android:layout_marginTop="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/plant_label_ll"
        android:textSize="13sp"
        android:hint="@string/plant_garden_name"
        android:inputType="text"
        android:letterSpacing="0.02"
        android:textColor="@color/black"
        android:id="@+id/plant_creating_garden_et"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:gravity="center"
        android:textStyle="bold"/>
    
    <ImageView
        android:id="@+id/plant_flower_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_plant_image"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/plant_creating_garden_et"/>

    <LinearLayout
        android:id="@+id/plant_progress_chart_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/plant_flower_iv">

        <ProgressBar
            android:id="@+id/plant_progress_chart_iv"
            android:layout_width="200dp"
            android:layout_height="16dp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_centerInParent="true"
            android:foreground="@drawable/img_progress_chart"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="13dp"
            android:elevation="5dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/rounded_progress_bar"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/plant_percent"
            android:textSize="12sp"
            android:letterSpacing="0.02"
            android:textColor="@color/wp_blue1" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/plant_pot_ll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/plant_progress_chart_ll"
        android:background="@drawable/img_rectangle_3"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/plant_flowerpot_name_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/plant_flowerpot_name"
            android:gravity="center"
            android:inputType="text"
            android:letterSpacing="0.01"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:background="@color/wp_transparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/plant_edit_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginStart="3dp"
            android:src="@drawable/ic_edit"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/plant_flowerpot_name_et"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:background="@drawable/ic_modify_user_information"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/plant_pot_ll"
        android:textSize="15sp"
        android:layout_marginTop="274dp"
        android:layout_width="268dp"
        android:layout_height="37dp"
        android:letterSpacing="0.02"
        android:elevation="5dp"
        android:id="@+id/plant_create_flowerpot_acb"
        android:gravity="center"
        android:textStyle="bold"
        android:text="화분 생성하기" />

</androidx.constraintlayout.widget.ConstraintLayout>