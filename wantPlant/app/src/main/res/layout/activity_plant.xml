<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF">

        <ImageView
            android:id="@+id/back_iv"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="11dp"
            android:layout_marginTop="38dp"
            android:background="@color/white"
            android:scaleType="fitXY"
            android:src="@drawable/ion_chevron_back_outline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/label_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/back_iv"
            app:layout_constraintBottom_toBottomOf="@+id/back_iv">

            <ImageView
                android:id="@+id/sparkle_iv"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/sparkles_outline"/>

            <TextView
                android:id="@+id/water_check_TODO_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="투두를 체크할 때마다 물을 줄 수 있어요."
                android:textSize="10sp"
                android:letterSpacing="0.03"
                android:textColor="#ACB774"
                />

        </LinearLayout>

        <ImageView
            android:id="@+id/plant_iv"
            android:layout_width="80dp"
            android:layout_height="78.76dp"
            android:layout_marginTop="64dp"
            android:src="@drawable/plant_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/label_ll" />

        <ImageView
            android:id="@+id/flowerpot_iv_02"
            android:layout_width="76.78dp"
            android:layout_height="53.72dp"
            android:layout_marginTop="121.18dp"
            android:src="@drawable/rectangle_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/label_ll" />

        <ImageView
            android:id="@+id/flowerpot_iv_01"
            android:layout_width="76.78dp"
            android:layout_height="12.16dp"
            android:layout_marginTop="118.57dp"
            android:src="@drawable/rectangle_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/label_ll" />

        <LinearLayout
            android:id="@+id/progress_chart_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/flowerpot_iv_02">

            <ImageView
                android:id="@+id/process_chart_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/process_chart"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="13dp"
                android:elevation="5dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="0%"
                android:textSize="12sp"
                android:letterSpacing="0.02"
                android:textColor="@color/wp_blue1" />

        </LinearLayout>

        <EditText
            android:id="@+id/flowerpot_name_et"
            android:elevation="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rectangle_3"
            android:hint="화분의 이름"
            android:gravity="center"
            android:inputType="text"
            android:letterSpacing="0.01"
            android:textColor="@color/wp_gray2"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progress_chart_ll"/>

        <ImageView
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_gravity="bottom"
            android:layout_marginEnd="83dp"
            android:layout_marginBottom="17dp"
            android:src="@drawable/ic_edit"
            app:layout_constraintEnd_toEndOf="@+id/flowerpot_name_et"
            app:layout_constraintBottom_toBottomOf="@+id/flowerpot_name_et"/>

        <EditText
            android:background="@drawable/ic_create_garden"
            android:layout_marginTop="23dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/label_ll"
            android:textSize="13sp"
            android:hint="정원 이름"
            android:inputType="text"
            android:letterSpacing="0.02"
            android:textColor="#757373"
            android:id="@+id/creating_garden_et"
            android:layout_width="144dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/edit_iv"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom"
            android:layout_marginEnd="83dp"
            android:layout_marginBottom="13dp"
            android:src="@drawable/ic_edit"
            app:layout_constraintEnd_toEndOf="@+id/flowerpot_name_et"
            app:layout_constraintBottom_toBottomOf="@+id/flowerpot_name_et"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/water_week_goal_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="36dp"
            app:layout_constraintTop_toBottomOf="@id/flowerpot_name_et"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:listitem="@layout/item_water_week_goal"/>

        <androidx.appcompat.widget.AppCompatButton
            android:background="@drawable/ic_modify_user_information"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/water_week_goal_rv"
            android:textSize="15sp"
            android:layout_marginTop="60dp"
            android:layout_width="268dp"
            android:layout_height="37dp"
            android:letterSpacing="0.02"
            android:elevation="5dp"
            android:id="@+id/create_flowerpot_acb"
            android:gravity="center"
            android:textStyle="bold"
            android:text="화분 생성하기"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>