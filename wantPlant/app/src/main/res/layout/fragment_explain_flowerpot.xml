<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF">

        <ImageView
            android:id="@+id/back_iv"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="11dp"
            android:layout_marginTop="38dp"
            android:background="@color/white"
            android:scaleType="fitXY"
            android:src="@drawable/ion_chevron_back_outline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/album_music_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="65dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_logo_wantplant"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <HorizontalScrollView
            android:id="@+id/water_week_title_hsv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/album_music_title_tv"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5sp"
                android:gravity="center"
                android:text="정원 이름"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/ic_create_garden"/>

        </HorizontalScrollView>

        <ImageView
            android:id="@+id/rectangle_image_iv_01"
            android:layout_width="300dp"
            android:layout_height="33dp"
            android:src="@drawable/rectangle_4"
            android:layout_marginTop="21dp"
            app:layout_constraintTop_toBottomOf="@id/water_week_title_hsv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="정원 이름"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/rectangle_image_iv_01"
            app:layout_constraintEnd_toEndOf="@+id/rectangle_image_iv_01"
            app:layout_constraintBottom_toBottomOf="@+id/rectangle_image_iv_01"
            app:layout_constraintTop_toTopOf="@+id/rectangle_image_iv_01"/>

        <ImageView
            android:id="@+id/vertical_line_iv_01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vertical_line"
            android:layout_marginStart="94dp"
            app:layout_constraintTop_toBottomOf="@id/rectangle_image_iv_01"
            app:layout_constraintStart_toStartOf="@id/rectangle_image_iv_01"/>

        <ImageView
            android:id="@+id/vertical_line_iv_02"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vertical_line"
            android:layout_marginEnd="94dp"
            app:layout_constraintTop_toBottomOf="@id/rectangle_image_iv_01"
            app:layout_constraintEnd_toEndOf="@id/rectangle_image_iv_01"/>

        <ImageView
            android:id="@+id/rectangle_iv_02"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/rectangle_5"
            app:layout_constraintTop_toBottomOf="@id/vertical_line_iv_02"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/category_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="카테고리"
            android:textStyle="bold"
            android:layout_marginTop="33dp"
            android:layout_marginStart="40dp"
            app:layout_constraintStart_toStartOf="@+id/rectangle_iv_02"
            app:layout_constraintTop_toTopOf="@+id/rectangle_iv_02"
            android:textSize="8sp"
            android:letterSpacing="0.03"
            android:textColor="#616161"
            android:lineSpacingExtra="11sp" />

        <TextView
            android:id="@+id/category_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="공부"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/category_tv"
            app:layout_constraintTop_toTopOf="@+id/category_tv"
            app:layout_constraintBottom_toBottomOf="@+id/category_tv"
            android:textSize="10sp"
            android:letterSpacing="0.03"
            android:lineSpacingExtra="8sp" />

        <TextView
            android:id="@+id/explain_garden_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="정원설명"
            android:textStyle="bold"
            android:layout_marginTop="13dp"
            android:layout_marginStart="40dp"
            app:layout_constraintStart_toStartOf="@+id/rectangle_iv_02"
            app:layout_constraintTop_toBottomOf="@+id/category_tv"
            android:textSize="8sp"
            android:letterSpacing="0.03"
            android:textColor="#616161"
            android:lineSpacingExtra="11sp" />

        <TextView
            android:id="@+id/explain_garden_label_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="나는 공부왕이 될거야 두고봐라"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/explain_garden_tv"
            app:layout_constraintTop_toTopOf="@+id/explain_garden_tv"
            app:layout_constraintBottom_toBottomOf="@+id/explain_garden_tv"
            android:textSize="10sp"
            android:letterSpacing="0.03"
            android:lineSpacingExtra="8sp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>