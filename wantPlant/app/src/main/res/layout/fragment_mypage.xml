<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <TextView
        android:id="@+id/mypage_welcome_user_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textStyle="bold"
        android:text="@string/mypage_welcome_user"
        android:gravity="center"
        android:textSize="25sp"
        android:letterSpacing="0.01"
        android:lineSpacingExtra="9sp"
        app:layout_constraintTop_toBottomOf="@+id/mypage_profile_image_iv"
        app:layout_constraintEnd_toEndOf="@+id/mypage_profile_image_iv"
        app:layout_constraintStart_toStartOf="@+id/mypage_profile_image_iv"/>

    <ImageView
        android:id="@+id/mypage_profile_image_iv"
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_marginTop="83dp"
        android:background="@color/white"
        android:src="@drawable/img_profile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/mypage_more_information_cv"
        android:layout_width="308dp"
        android:layout_height="126dp"
        app:cardCornerRadius="15dp"
        android:layout_marginTop="85dp"
        app:layout_constraintTop_toBottomOf="@+id/mypage_welcome_user_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="5dp"
        app:cardBackgroundColor="@color/wp_main_btn" >

        <LinearLayout
            android:id="@+id/mypage_more_information_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraint_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mypage_terms_and_conditions_of_use_cl"
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <TextView
                    android:id="@+id/mypage_terms_and_conditions_of_use_tv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="이용약관"
                    android:paddingLeft="18dp"
                    android:gravity="center_vertical" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_height="1dp"
                android:background="#FFFFFF" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mypage_personal_information_processing_policy_cl"
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <TextView
                    android:id="@+id/mypage_personal_information_processing_policy_tv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="18dp"
                    android:text="@string/mypage_personal_information_processing_policy"
                    android:gravity="center_vertical"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_height="1dp"
                android:background="#FFFFFF" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mypage_howtouse_cl"
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <TextView
                    android:id="@+id/mypage_howtouse_tv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="18dp"
                    android:text="@string/mypage_howtouse"
                    android:gravity="center_vertical" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/mypage_logout_and_withdrawal_cv"
        android:layout_width="308dp"
        android:layout_height="84dp"
        app:cardCornerRadius="15dp"
        android:layout_marginTop="34dp"
        app:layout_constraintTop_toBottomOf="@+id/mypage_more_information_cv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="5dp"
        app:cardBackgroundColor="@color/wp_main_btn">

        <LinearLayout
            android:id="@+id/mypage_logout_and_withdrawal_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraint_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mypage_logout_cl"
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <TextView
                    android:id="@+id/mypage_logout_tv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="18dp"
                    android:text="@string/mypage_logout"
                    android:gravity="center_vertical" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_height="1dp"
                android:background="#FFFFFF" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mypage_withdrawal_cl"
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <TextView
                    android:id="@+id/mypage_withdrawal_tv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="18dp"
                    android:text="@string/mypage_withdrawal"
                    android:gravity="center_vertical" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>