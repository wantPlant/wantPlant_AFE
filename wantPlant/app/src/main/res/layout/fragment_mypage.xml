<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <TextView
        android:id="@+id/welcome_user_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textStyle="bold"
        android:text="삶을 가꾸는 하니님,\n환영해요!"
        android:gravity="center"
        android:textSize="25sp"
        android:letterSpacing="0.01"
        android:lineSpacingExtra="9sp"
        app:layout_constraintTop_toBottomOf="@+id/profile_image_iv"
        app:layout_constraintEnd_toEndOf="@+id/profile_image_iv"
        app:layout_constraintStart_toStartOf="@+id/profile_image_iv"/>

    <ImageView
        android:id="@+id/profile_image_iv"
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_marginTop="83dp"
        android:background="@color/white"
        android:src="@drawable/profile_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:background="@drawable/ic_modify_profile"
        android:layout_marginTop="193dp"
        android:id="@+id/modify_profile_acb"
        android:layout_width="33dp"
        android:layout_height="15dp"
        android:gravity="center"
        android:textSize="7sp"
        android:letterSpacing="0.04"
        android:text="수정"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/more_information_cv"
        android:layout_width="308dp"
        android:layout_height="126dp"
        app:cardCornerRadius="15dp"
        android:layout_marginTop="85dp"
        app:layout_constraintTop_toBottomOf="@+id/welcome_user_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="5dp"
        app:cardBackgroundColor="@color/wp_main_btn" >

        <LinearLayout
            android:id="@+id/more_information_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraint_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/terms_and_conditions_of_use_cl"
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <TextView
                    android:id="@+id/terms_and_conditions_of_use_tv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="이용약관"
                    android:paddingLeft="18dp"
                    android:gravity="center_vertical" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_height="1dp"
                android:background="#FFFFFF" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/personal_information_processing_policy_cl"
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <TextView
                    android:id="@+id/personal_information_processing_policy_tv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="18dp"
                    android:text="개인정보처리방침"
                    android:gravity="center_vertical"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_height="1dp"
                android:background="#FFFFFF" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/app_version_cl"
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <TextView
                    android:id="@+id/app_version_tv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="18dp"
                    android:text="사용 설명서"
                    android:gravity="center_vertical" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/logout_and_withdrawal_cv"
        android:layout_width="308dp"
        android:layout_height="84dp"
        app:cardCornerRadius="15dp"
        android:layout_marginTop="34dp"
        app:layout_constraintTop_toBottomOf="@+id/more_information_cv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="5dp"
        app:cardBackgroundColor="@color/wp_main_btn">

        <LinearLayout
            android:id="@+id/logout_and_withdrawal_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraint_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/Logout_cl"
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <TextView
                    android:id="@+id/logout_tv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="18dp"
                    android:text="로그아웃"
                    android:gravity="center_vertical" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_height="1dp"
                android:background="#FFFFFF" />

           <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/withdrawal_cl"
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <TextView
                    android:id="@+id/withdrawal_tv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingLeft="18dp"
                    android:text="탈퇴하기"
                    android:gravity="center_vertical" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>