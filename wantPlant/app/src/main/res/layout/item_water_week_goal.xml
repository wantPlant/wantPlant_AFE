<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_plus_goal_cl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/item_goal_view"
            android:layout_width="2dp"
            android:layout_height="36dp"
            android:background="@color/wp_green3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/item_goal_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="목표"
            android:textColor="@color/black"
            android:background="@null"
            android:textSize="18dp"
            app:layout_constraintTop_toTopOf="@id/item_goal_view"
            app:layout_constraintBottom_toBottomOf="@id/item_goal_view"
            app:layout_constraintStart_toEndOf="@id/item_goal_view"/>


        <ImageView
            android:id="@+id/item_goal_plus_btn_iv"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_garden_plus_btn"
            android:layout_marginStart="5dp"
            app:layout_constraintTop_toTopOf="@id/item_goal_title_tv"
            app:layout_constraintBottom_toBottomOf="@id/item_goal_title_tv"
            app:layout_constraintStart_toEndOf="@id/item_goal_title_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/item_goal_todo_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/item_plus_goal_cl"
        app:layout_constraintStart_toStartOf="parent"
        tools:listitem="@layout/item_water_week_todo"/>

</androidx.constraintlayout.widget.ConstraintLayout>