<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ImageView
        android:id="@+id/whole_plant_back_iv"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="11dp"
        android:layout_marginTop="38dp"
        android:background="@color/white"
        android:scaleType="fitXY"
        android:src="@drawable/ion_chevron_back_outline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/whole_plant_label_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/whole_plant_back_iv"
        app:layout_constraintBottom_toBottomOf="@+id/whole_plant_back_iv">

        <ImageView
            android:id="@+id/whole_plant_sparkle_iv"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_sparkles_outline"/>

        <TextView
            android:id="@+id/whole_plant_water_check_TODO_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="투두를 체크할 때마다 물을 줄 수 있어요."
            android:textSize="10sp"
            android:letterSpacing="0.03"
            android:textColor="#ACB774"
            />

    </LinearLayout>

    <EditText
        android:background="@drawable/ic_create_garden"
        android:layout_marginTop="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/whole_plant_label_ll"
        android:textSize="13sp"
        android:hint="@string/plant_garden_name"
        android:inputType="text"
        android:letterSpacing="0.02"
        android:textColor="#757373"
        android:id="@+id/whole_plant_creating_garden_et"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:gravity="center"
        android:textStyle="bold"/>

    <ImageView
        android:id="@+id/whole_plant_pot_iv"
        android:layout_width="140dp"
        android:layout_height="130dp"
        app:layout_constraintTop_toBottomOf="@id/whole_plant_creating_garden_et"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/whole_plant_progress_chart_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/whole_plant_pot_iv">

        <ProgressBar
            android:id="@+id/whole_plant_progress_chart_iv"
            android:layout_width="200dp"
            android:layout_height="16dp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_centerInParent="true"
            android:foreground="@drawable/img_progress_chart"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="13dp"
            android:elevation="5dp"
            android:max="30"
            android:progress="0"
            android:progressDrawable="@drawable/rounded_progress_bar"/>

        <TextView
            android:id="@+id/whole_plant_progress_chart_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/plant_percent"
            android:textSize="12sp"
            android:letterSpacing="0.02"
            android:textColor="@color/wp_blue1" />

    </LinearLayout>

    <EditText
        android:id="@+id/whole_plant_flowerpot_name_et"
        android:elevation="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/img_rectangle_3"
        android:hint="@string/plant_flowerpot_name"
        android:gravity="center"
        android:inputType="text"
        android:letterSpacing="0.01"
        android:textColorHint="@color/black"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/whole_plant_progress_chart_ll"/>

    <ImageView
        android:id="@+id/whole_plant_edit_iv"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="bottom"
        android:layout_marginEnd="83dp"
        android:layout_marginBottom="13dp"
        android:src="@drawable/ic_edit"
        app:layout_constraintEnd_toEndOf="@+id/whole_plant_flowerpot_name_et"
        app:layout_constraintBottom_toBottomOf="@+id/whole_plant_flowerpot_name_et"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/whole_plant_pot_name_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@id/whole_plant_flowerpot_name_et"
        app:layout_constraintStart_toStartOf="parent"
        android:overScrollMode="never"
        android:orientation="horizontal"
        android:layout_marginStart="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_plant_flowerpot_name" />

    <LinearLayout
        android:id="@+id/whole_plant_add_goal_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginStart="15dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/whole_plant_pot_name_rv"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="visible">

        <ImageView
            android:id="@+id/whole_plant_add_pot_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_garden_plus_btn"/>

        <TextView
            android:id="@+id/whole_plant_add_pot_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/water_week_add_goal"
            android:textStyle="bold"
            android:textColor="@color/wp_brown2"
            android:layout_marginStart="5dp"
            android:textSize="15dp"/>

    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/whole_plant_goal_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="13dp"
        app:layout_constraintTop_toBottomOf="@id/whole_plant_add_goal_ll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_water_week_goal"
        android:overScrollMode="never"
        />

</androidx.constraintlayout.widget.ConstraintLayout>