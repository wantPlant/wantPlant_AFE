<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <ImageView
        android:id="@+id/findpw_logo_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="30dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="154dp"
        android:src="@drawable/ic_findpw_logo"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <EditText
        android:id="@+id/findpw_name_et"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_login_rect"
        android:layout_marginHorizontal="30dp"
        android:paddingHorizontal="25dp"
        android:hint="이름"
        android:inputType="text"
        android:textColor="@color/wp_gray2"
        android:textSize="14dp"
        android:layout_marginTop="373dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <EditText
        android:id="@+id/findpw_password_et"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_login_rect"
        android:layout_marginHorizontal="30dp"
        android:paddingHorizontal="25dp"
        android:hint="이메일 주소"
        android:inputType="text"
        android:textColor="@color/wp_gray2"
        android:textSize="14dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/findpw_name_et"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/findpw_start_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_login_background"
        android:layout_marginTop="689dp"
        android:layout_marginHorizontal="30dp"
        android:text="@string/btn_okay"
        android:textSize="18dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>