<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <ImageView
        android:id="@+id/login_wantplant_logo_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_logo_wantplant"
        android:layout_marginTop="103dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/login_email_et"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_login_rect"
        android:layout_marginHorizontal="30dp"
        android:paddingHorizontal="25dp"
        android:hint="이메일 주소"
        android:inputType="text"
        android:textColor="#757373"
        android:textSize="14dp"
        android:layout_marginTop="238dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/login_email_wrong_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:text="@string/wrong_email"
        android:textColor="@color/wp_red"
        android:textSize="11dp"
        app:layout_constraintStart_toStartOf="@+id/login_email_et"
        app:layout_constraintTop_toBottomOf="@+id/login_email_et"
        />

    <EditText
        android:id="@+id/login_password_et"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_login_rect"
        android:layout_marginHorizontal="30dp"
        android:paddingHorizontal="25dp"
        android:hint="비밀번호"
        android:inputType="text"
        android:textColor="#757373"
        android:textSize="14dp"
        android:layout_marginTop="325dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/login_pw_wrong_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:text="@string/wrong_pw"
        android:textColor="@color/wp_red"
        android:textSize="11dp"
        app:layout_constraintStart_toStartOf="@+id/login_password_et"
        app:layout_constraintTop_toBottomOf="@+id/login_password_et"
        />

    <ImageView
        android:id="@+id/login_view_pw_on_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_btn_eyeline_on"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toTopOf="@id/login_password_et"
        app:layout_constraintEnd_toEndOf="@id/login_password_et"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:id="@+id/login_view_pw_off_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_btn_eyeline_off"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toTopOf="@id/login_password_et"
        app:layout_constraintEnd_toEndOf="@id/login_password_et"
        android:visibility="gone"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:id="@+id/login_find_pw_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="5dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_btn_findpw"
        app:layout_constraintEnd_toEndOf="@id/login_password_et"
        app:layout_constraintTop_toBottomOf="@+id/login_password_et"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:id="@+id/login_find_email_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_btn_findemail"
        app:layout_constraintEnd_toStartOf="@+id/login_find_pw_iv"
        app:layout_constraintTop_toBottomOf="@id/login_password_et"
        tools:ignore="MissingConstraints" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/login_start_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_login_background"
        android:layout_marginTop="506dp"
        android:layout_marginHorizontal="30dp"
        android:text="@string/btn_start"
        android:textSize="18dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/login_account_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_account"
        android:textSize="13dp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_start_btn"/>

    <View
        android:id="@+id/login_password_underscore_view"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="624dp"
        android:background="wp_gray5"
        app:layout_constraintEnd_toEndOf="@+id/login_start_btn"
        app:layout_constraintStart_toStartOf="@+id/login_start_btn"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:id="@+id/login_kakao_lo"
        android:layout_width="259dp"
        android:layout_height="41dp"
        android:background="@drawable/ic_login_kakao"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_password_underscore_view"
        android:orientation="horizontal" />


</androidx.constraintlayout.widget.ConstraintLayout>